# Copy to `.env` and edit as needed.
# `.env` is gitignored — never commit secrets.

# Where uploads, recordings, models, and the SQLite DB live.
# Default if unset: ~/Rhetor/data
RHETOR_DATA_DIR=

# API server
RHETOR_HOST=127.0.0.1
RHETOR_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
RHETOR_LOG_LEVEL=INFO
